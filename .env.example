# ---------- API ----------
# MongoDB connection string. Must be a replica set for transactions.
# Leave EMPTY to let the API start an embedded replica set that persists to <repo>/.mongo-data (dev only).
# For Docker Compose / a real server use e.g. mongodb://localhost:27017/pharmacyos?replicaSet=rs0
MONGODB_URI=
# Secret used to sign access/refresh JWTs. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
API_PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Set to "true" when serving over HTTPS so auth cookies are marked Secure
COOKIE_SECURE=false
LOG_LEVEL=info
# Optional: enables the LLM narration layer of the assistant. Core assistant works without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: Redis for BullMQ background jobs. If empty, jobs run in-process via @nestjs/schedule.
REDIS_URL=

# ---------- WEB ----------
# Public URL the browser uses to reach the API
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Server-side URL (used by Next.js server for proxying/health)
API_INTERNAL_URL=http://localhost:4000/api/v1
